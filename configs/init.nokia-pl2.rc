# Import common mainline init services
import /vendor/etc/init/hw/init.mainline.rc

on early-init
    # Set up bootdevice symlink for mainline eMMC controller (soc@0/c0c4000.mmc)
    wait /dev/block/platform/soc@0/c0c4000.mmc 10
    symlink /dev/block/platform/soc@0/c0c4000.mmc /dev/block/bootdevice
    mkdir /dev/block/platform/soc 0755 root root
    symlink /dev/block/platform/soc@0/c0c4000.mmc /dev/block/platform/soc/c0c4000.sdhci
    symlink /dev/block/platform/soc@0/c0c4000.mmc /dev/block/platform/soc/c0c4000.mmc

on fs
    # Mount partitions without latemount
    mount_all /vendor/etc/fstab.nokia-pl2 --early

on post-fs
    # Load mainline kernel modules
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -s -d /vendor/lib/modules --all=/vendor/etc/modules.load.normal
    # Start Qualcomm DSP and remote processors
    trigger start_all_remoteproc

on late-fs
    # Mount userdata and partitions requiring fsck
    mount_all /vendor/etc/fstab.nokia-pl2 --late

on init
    # Configure USB gadget controller (Mainline Linux 7.2 UDC platform device on SDM630)
    setprop sys.usb.configfs 1
    setprop sys.usb.controller a800000.usb
    setprop vendor.usb.controller a800000.usb

on boot
    # Permissions for DRM render nodes (touchscreen & key input nodes handled dynamically by ueventd)
    chmod 0666 /dev/dri/card0
    chmod 0666 /dev/dri/renderD128
