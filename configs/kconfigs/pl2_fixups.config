# Nokia 6.1 (PL2) Kernel Config Fixups for Mainline Android 17

# Framebuffer & Early Console for Screen Output
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_DRM_SIMPLEDRM=n
CONFIG_DRM_MSM=y

# Qualcomm Regulators, Power & SMD RPM (SDM630 architecture)
CONFIG_QCOM_SMD_RPM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMPD=y

# Qualcomm Clocks & Core Architecture (SDM630)
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_SDM_GCC_660=y
CONFIG_SDM_MMCC_660=y
CONFIG_SDM_GPUCC_660=y

# Storage & eMMC 5.1 Controller (First-Stage Mount)
CONFIG_MMC=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y

# Filesystems (First-Stage Mount for /system, /vendor, /metadata, /data)
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_QUOTACTL=y

# USB Gadget & DWC3 Controller (Early ADB & Recovery Shell)
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_EXTCON_USB_GPIO=y

# Android 17 Memory, IPC & LMKD
CONFIG_ASHMEM=n
CONFIG_MEMFD_CREATE=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n

# Toolchain Stability
CONFIG_RUST=n
CONFIG_LTO_NONE=y

# Ramoops / Pstore for Crash Dumps (0xACB00000 as configured in sdm630-nokia-pl2.dts)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y

