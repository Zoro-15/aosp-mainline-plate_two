# Nokia 6.1 (PL2) Kernel Config Fixups for Mainline Android 17

# Framebuffer & Early Console for Screen Output
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_DRM_MSM=y

# Qualcomm Regulators, Power & SMD RPM (SDM630 architecture)
CONFIG_QCOM_SMD_RPM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMPD=y

# Qualcomm SPMI PMIC Arbiter, Pin Controllers & Interconnect
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SDM660=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SDM660=y
CONFIG_INTERCONNECT_QCOM_SMD_RPM=y

# Qualcomm Clocks & Core Architecture (SDM630)
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_SMD_RPM=y
CONFIG_SDM_GCC_660=y
CONFIG_SDM_MMCC_660=y
CONFIG_SDM_GPUCC_660=y

# Storage & eMMC 5.1 Controller (First-Stage Mount)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y

# Device Mapper & Retrofit Dynamic Partitions (dm-linear)
CONFIG_BLK_DEV_DM=y
CONFIG_DM_UEVENT=y

# Display Panel & Touchscreen Drivers (Raydium R69338 / Goodix GT1152)
CONFIG_DRM_PANEL_FT8716U=y
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_I2C_QUP=y

# Filesystems (First-Stage Mount for /system, /vendor, /metadata, /data)
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_QUOTACTL=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_CRC32_ARM64_CE=y

# USB Gadget & DWC3 Controller (Early ADB, CDC-ACM Serial & Recovery Shell)
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_ANDROID_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_EXTCON_USB_GPIO=y

# Android 17 Memory, IPC & LMKD
# CONFIG_ASHMEM is not set
CONFIG_MEMFD_CREATE=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y

# Modern Android 17 Gralloc / DMA-BUF Heaps (Required for minigbm & SurfaceFlinger)
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# Display & Backlight Control (WLED on PMIC)
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_QCOM_WLED=y

# Toolchain Stability
# CONFIG_RUST is not set
CONFIG_LTO_NONE=y

# Ramoops / Pstore for Crash Dumps (0xACB00000 as configured in sdm630-nokia-pl2.dts)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y

# Android Security & SELinux (Required for First-Stage Mount /init)
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_DEFAULT_SECURITY_SELINUX=y

# Cgroups v1 Backward Compatibility (Android 17 GSI libprocessgroup / cpuset mount)
CONFIG_CPUSETS=y
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG=y
CONFIG_MEMCG_V1=y
