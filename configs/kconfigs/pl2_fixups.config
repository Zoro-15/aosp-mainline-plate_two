# Nokia 6.1 (PL2) Kernel Config Fixups for Mainline Android 17
# Simple Framebuffer & Console for early boot log visibility
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# DRM & MSM Display
CONFIG_DRM_MSM=y
CONFIG_DRM_SIMPLEDRM=y

# Qualcomm Regulators, Clocks & Interconnects
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_COMMAND_DB=y

# Android specific
CONFIG_ASHMEM=n
CONFIG_MEMFD_CREATE=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
