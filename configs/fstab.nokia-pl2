# Android fstab file for Nokia 6.1 (PL2) Mainline
# Repurposed logdump as /metadata, Retrofit Dynamic Partitions

# Logical dynamic partitions
system       /system       ext4   ro,barrier=1,discard   wait,slotselect,logical,first_stage_mount
vendor       /vendor       ext4   ro,barrier=1,discard   wait,slotselect,logical,first_stage_mount
system_ext   /system_ext   ext4   ro,barrier=1,discard   wait,slotselect,logical,first_stage_mount
product      /product      ext4   ro,barrier=1,discard   wait,slotselect,logical,first_stage_mount
odm          /odm          ext4   ro,barrier=1,discard   wait,slotselect,logical,first_stage_mount

# Metadata & physical partitions
/dev/block/by-name/logdump               /metadata             ext4   nosuid,nodev,noatime,discard,sync                wait,formattable,first_stage_mount
/dev/block/by-name/userdata              /data                 ext4   noatime,nosuid,nodev,barrier=1,discard,errors=panic wait,check,latemount,formattable,quota,reservedsize=128M
/dev/block/by-name/misc                  /misc                 emmc   defaults                                         defaults
/dev/block/by-name/modem                 /vendor/firmware_mnt  vfat   ro,shortname=lower,uid=0,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait,slotselect
/dev/block/by-name/bluetooth             /vendor/bt_firmware   vfat   ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0 wait,slotselect
/dev/block/by-name/dsp                   /vendor/dsp           ext4   ro,nosuid,nodev,barrier=1                        wait,slotselect
/dev/block/by-name/persist               /mnt/vendor/persist   ext4   noatime,nosuid,nodev,barrier=1                   wait
/dev/block/zram0                         none                  swap   defaults                                         zramsize=2147483648
